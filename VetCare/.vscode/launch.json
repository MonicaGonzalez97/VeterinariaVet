{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "VetCare.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "compilar-api",
      "program": "${workspaceFolder}/VetCare.Api/bin/Debug/net10.0/VetCare.Api.dll",
      "cwd": "${workspaceFolder}/VetCare.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    }
  ]
}
